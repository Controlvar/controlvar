# Controlvar dashboard — build-time public configuration.
# Copy to .env.local for local overrides (gitignored). Only NEXT_PUBLIC_* values
# reach the browser and they are inlined by `next build`, so rebuild after changes.

# Origin of the API. Leave EMPTY for the container image: the frontend nginx
# proxies /api/, /health* and /ws/ to the backend on the same origin.
# `npm run dev` (NODE_ENV=development) falls back to http://localhost:8000 when
# this is unset; set it explicitly when your backend runs elsewhere.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: explicit WebSocket origin for live results. Defaults to
# NEXT_PUBLIC_API_URL with ws(s)://, or the page origin when that is empty.
# NEXT_PUBLIC_WS_URL=ws://localhost:8000
