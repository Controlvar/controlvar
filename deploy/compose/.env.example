# deploy/compose/.env.example -- every setting compose.yml reads.
#
# Prefer ./generate-env.sh, which writes .env with generated secrets and
# refuses to overwrite one that exists. To fill it by hand instead, copy this
# file to .env and set the five REQUIRED values; compose refuses to start
# while any of them is empty.

# --- REQUIRED ---------------------------------------------------------------
# The URL people open. The API answers only for this host name, so it must be
# exactly what the browser shows (scheme and host, no path, no trailing slash).
PUBLIC_BASE_URL=
# openssl rand -hex 32
SECRET_KEY=
# openssl rand -hex 24
POSTGRES_PASSWORD=
# The first administrator. Used only while the database has no users:
# changing it after the first start does nothing.
FIRST_SUPERUSER=
# openssl rand -base64 18
FIRST_SUPERUSER_PASSWORD=

# --- Profile ----------------------------------------------------------------
# core (default) or full. full needs AUDIT_HMAC_KEY (openssl rand -hex 32).
# Changing AUDIT_HMAC_KEY later makes existing audit signatures unverifiable.
EXPERIMENTLY_PROFILE=core
AUDIT_HMAC_KEY=

# --- Optional ---------------------------------------------------------------
# Where the dashboard listens on this host. Loopback by default: put a TLS
# reverse proxy in front and forward the Host header unchanged.
# HTTP_BIND=127.0.0.1
# HTTP_PORT=8080

# An external PostgreSQL instead of the bundled one. Start only the api and
# web services then: docker compose up -d api web
# The database server's TimeZone must be UTC: on another time zone some
# times the API stores, such as an experiment's updated_at, move by the
# zone's offset.
# POSTGRES_SERVER=
# POSTGRES_PORT=5432
# POSTGRES_USER=experimently
# POSTGRES_DB=experimentation

# An external Redis (no password) instead of the bundled one.
# REDIS_HOST=
# REDIS_PORT=6379

# Optional features: each is off while its key is unset or empty.
# Warehouse analysis (full profile): Fernet keys, comma-separated, newest
# first, that encrypt the warehouse credentials the API stores. Make one with
# openssl rand -base64 32 | tr '+/' '-_'
# WAREHOUSE_CREDENTIALS_KEYS=
# LLM experiments: the key of each provider your variants use.
# ANTHROPIC_API_KEY also turns on Claude in POST /api/v1/ai/design and
# POST /api/v1/ai/interpret/{experiment_id}.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Bearer token for /metrics (403 without one).
# METRICS_TOKEN=
# LOG_LEVEL=INFO
# API worker processes per container.
# WEB_CONCURRENCY=1
