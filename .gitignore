# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
coverage.xml
htmlcov/
venv/
# Environment files — only .env.example should be committed
.env
.env.local
.env.dev
.env.prod
.env.test
.env.staging
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
*.egg-info/
*.log

# JavaScript
node_modules/
.next/
dist/
build/
coverage/
out/

# Infrastructure
cdk.out/
.aws-sam/

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Temporary files
*.tmp
*.bak
*.swp
*~
.mypy_cache/
# import-linter (make lint) caches its import graph next to each config
.import_linter_cache/

# Test artifacts
test.log
app.log
*.coverage

# Note: Keep backend/__init__.py and backend/app/**/__init__.py
# Only ignore root-level __init__.py if accidentally created

# ============================================================================
# SENSITIVE DATA PROTECTION - Commercial Product
# ============================================================================

# Customer data and production configurations
customer-data/
production-config/
client-configs/
*.production.yaml
*.production.json
*-prod.env
*-production.env

# Credentials and secrets
credentials.json
secrets.yaml
*.key
*.pem
*.p12
*.pfx
*_rsa
*_dsa
*_ecdsa
*_ed25519
.secrets/
secrets/
aws-credentials
gcp-credentials
azure-credentials

# Database dumps and backups
*.sql
# ...but not the warehouse query builder's golden statements, which are
# generated SQL text the tests compare byte for byte, not data.
!modules/backend/tests/unit/warehouse/golden/*.sql
!modules/backend/tests/unit/warehouse/parity/*.sql
*.dump
*.backup
db-backup/
database-backups/
*.db
*.sqlite
*.sqlite3

# API keys and tokens
.api-keys
api-keys.txt
*.token
access-tokens/

# Internal documentation (not for public consumption)
internal-docs/
confidential/
proprietary/

# Production deployment artifacts
production-deployment/
*.production.tfstate
*.production.tfvars

# Customer-specific code or configurations
customers/
client-specific/
custom-implementations/

# Financial and business data
invoices/
contracts/
financial-data/

# Personal Identifiable Information (PII)
pii-data/
user-data/
customer-info/

# Analytics and metrics data with real user information
analytics-data/
metrics-data/*.csv
user-metrics/

# AWS/Cloud provider specific
.aws/
aws-config/
terraform.tfstate
terraform.tfstate.backup
.terraform/

# Docker production builds
docker-compose.production.yml
Dockerfile.production

# Monitoring and logging with sensitive data
logs/
*.log
error-logs/
access-logs/

# Local demo runtime artifacts (generated by demo/setup-local.sh and seed scripts)
demo/.pids/
demo/.logs/
demo/.demo_api_key
demo/shoplab/.api_key
demo/shoplab/.env.local

# Live SDK contract API keys (generated by backend/scripts/seed_sdk_contract.py)
tests/sdk-contract/live/.api_key
tests/sdk-contract/live/.api_key_local
demo/streampulse/.api_key
demo/streampulse/.api_key_server
demo/streampulse/.env.local

# The react-native live contract writes its report here (Jest owns stdout, so the
# runner reads the file instead); see sdk/react-native/examples/contract_smoke.test.ts
sdk/react-native/.contract_smoke.json

# Ruby SDK: a gem should not lock its own dependencies; `bundle install`
# regenerates this locally and in CI (sdk-unit-tests.yml).
sdk/ruby/Gemfile.lock

# PHP SDK: composer install output
sdk/php/vendor/
sdk/php/composer.lock

# Elixir SDK build output
sdk/elixir/_build/
sdk/elixir/deps/

# .NET SDK build output
sdk/dotnet/**/bin/
sdk/dotnet/**/obj/

# Flutter SDK build output
sdk/flutter/.dart_tool/
sdk/flutter/.packages
sdk/flutter/pubspec.lock

# Playwright run output (reports, traces, screenshots)
frontend/playwright-results/
frontend/playwright-report/


# Local agent settings: ignored here too, not only in a developer’s global
# ignore file, so a fresh clone never commits one.
**/.claude/settings.local.json
backend/.venv/
site/

# The licence gate writes this beside the real document when it fails.
THIRD_PARTY_LICENSES.generated.md

# scripts/restore_repoint.sh evidence: names the account's resources, never committed
/restore-*-[0-9]*/
