{
    "name": "controlvar/sdk",
    "description": "PHP SDK for Controlvar A/B testing and feature flag platform",
    "type": "library",
    "license": "MIT",
    "keywords": ["a/b testing", "feature flags", "experimentation", "sdk"],
    "homepage": "https://github.com/Controlvar/controlvar",
    "authors": [
        {
            "name": "Controlvar",
            "email": "hello@controlvar.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Controlvar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Controlvar\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
