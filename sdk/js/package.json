{
  "name": "@controlvar/js-sdk",
  "version": "0.1.1",
  "description": "JavaScript/TypeScript SDK for the Controlvar public API (Node >= 18 and browsers, zero runtime dependencies)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "smoke": "npm run build --silent && node examples/contract_smoke.mjs"
  },
  "keywords": [
    "experimentation",
    "feature-flags",
    "ab-testing",
    "javascript",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Controlvar/controlvar.git",
    "directory": "sdk/js"
  },
  "homepage": "https://github.com/Controlvar/controlvar/tree/main/sdk/js#readme",
  "bugs": {
    "url": "https://github.com/Controlvar/controlvar/issues"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ]
  }
}
