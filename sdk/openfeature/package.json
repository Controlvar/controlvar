{
  "name": "@controlvar/openfeature-provider",
  "version": "0.1.0",
  "description": "OpenFeature provider for Controlvar (delegates to @controlvar/js-sdk)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm --prefix ../js run build --silent",
    "build": "tsc",
    "pretest": "npm --prefix ../js run build --silent",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "smoke": "npm run build --silent && node examples/contract_smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openfeature",
    "feature-flags",
    "experimentation",
    "a/b-testing",
    "provider"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Controlvar/controlvar.git",
    "directory": "sdk/openfeature"
  },
  "dependencies": {
    "@controlvar/js-sdk": "file:../js"
  },
  "peerDependencies": {
    "@openfeature/server-sdk": "^1.7.0"
  },
  "devDependencies": {
    "@openfeature/server-sdk": "^1.23.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.19.43",
    "jest": "^29.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ]
  }
}
