<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFrameworks>netstandard2.1;net6.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
    <PackageId>Controlvar.SDK</PackageId>
    <Version>0.2.0</Version>
    <Authors>Controlvar</Authors>
    <Description>Official .NET/C# SDK for Controlvar — server-decided feature flags, A/B experiment assignment and event tracking.</Description>
    <PackageTags>experimentation;feature-flags;ab-testing;sdk</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <!-- System.Text.Json is part of the shared framework on net6.0 but not on netstandard2.1. -->
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>
</Project>
