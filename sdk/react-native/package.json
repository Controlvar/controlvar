{
  "name": "@controlvar/react-native-sdk",
  "version": "0.1.0",
  "description": "React Native SDK for Controlvar — server-decided feature flags and A/B assignments, event tracking, in-memory cache and AsyncStorage offline fallback.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": ["src"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Controlvar/controlvar.git",
    "directory": "sdk/react-native"
  },
  "homepage": "https://github.com/Controlvar/controlvar/tree/main/sdk/react-native#readme",
  "bugs": {
    "url": "https://github.com/Controlvar/controlvar/issues"
  },
  "keywords": [
    "experimentation",
    "feature-flags",
    "ab-testing",
    "react-native"
  ],
  "license": "MIT",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.jest.json"
  },
  "dependencies": {
    "@types/md5": "^2.3.5",
    "md5": "^2.3.0"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@testing-library/react-native": "^12.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.0.0",
    "@types/react-native": "^0.73.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "react": "^18.0.0",
    "react-native": "^0.88.1",
    "react-test-renderer": "18.2.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.21.0 <4",
    "react": ">=16.8.0",
    "react-native": ">=0.65.0"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.jest.json"
        }
      ]
    },
    "testMatch": [
      "**/__tests__/**/*.test.(ts|tsx)"
    ],
    "moduleNameMapper": {
      "@react-native-async-storage/async-storage": "<rootDir>/__mocks__/@react-native-async-storage/async-storage.ts"
    }
  }
}
