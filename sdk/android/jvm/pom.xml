<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ═══════════════════════════════════════════════════════════════════════
         JVM-only variant of the Android SDK.

         Every file under ../sdk/src/main/kotlin is plain Kotlin/JVM: the SDK
         touches no android.* API (OfflineStore talks to a PrefsAdapter
         interface, ResultCache is hand-rolled rather than android.util.LruCache,
         JSON goes through org.json — which android.jar only stubs, so the real
         implementation is a dependency here exactly as it is for the Gradle
         unit tests).

         That makes two things possible without an Android SDK or an emulator:

           mvn -f sdk/android/jvm/pom.xml test      # the SDK's unit tests
           bash sdk/android/examples/contract_smoke.sh   # the live contract

         The Gradle build (../build.gradle.kts, ../sdk/build.gradle.kts) stays
         the source of truth for the published AAR and still runs nightly;
         `settings.gradle.kts` only includes ":sdk", so this directory is
         invisible to it.
         ═══════════════════════════════════════════════════════════════════════ -->

    <groupId>com.controlvar</groupId>
    <artifactId>controlvar-android-jvm</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Controlvar Android SDK — JVM variant</name>
    <description>
        Compiles the Android SDK's Kotlin sources for a plain JVM so its unit tests and
        its live contract smoke can run on a Linux CI runner without the Android SDK.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <kotlin.version>1.9.22</kotlin.version>
        <kotlin.compiler.jvmTarget>17</kotlin.compiler.jvmTarget>
        <coroutines.version>1.7.3</coroutines.version>
        <okhttp.version>4.12.0</okhttp.version>
        <junit.version>5.10.1</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-core</artifactId>
            <version>${coroutines.version}</version>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp.version}</version>
        </dependency>
        <!-- android.jar ships org.json as stubs only; the real implementation is
             what both the Gradle unit tests and this variant compile against. -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20240303</version>
        </dependency>

        <!-- ── test ──────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-test</artifactId>
            <version>${coroutines.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>${okhttp.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <sourceDirs>
                                <!-- the shipped SDK -->
                                <sourceDir>${project.basedir}/../sdk/src/main/kotlin</sourceDir>
                                <!-- the contract smoke's main() -->
                                <sourceDir>${project.basedir}/src/main/kotlin</sourceDir>
                            </sourceDirs>
                        </configuration>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals><goal>test-compile</goal></goals>
                        <configuration>
                            <sourceDirs>
                                <sourceDir>${project.basedir}/../sdk/src/test/kotlin</sourceDir>
                            </sourceDirs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.2</version>
                <configuration>
                    <!-- The SDK's tests are @Nested-heavy JUnit 5; surefire 3 runs
                         nested classes, and a failure fails the build. -->
                    <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                </configuration>
            </plugin>

            <!-- Runtime dependencies next to the classes so the contract smoke can
                 run with `java -cp "target/classes:target/lib/*"`. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-runtime-dependencies</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
