{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Controlvar chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["publicBaseUrl", "profile", "auth", "image", "secrets", "api", "web", "ingress", "postgresql", "redis"],
  "properties": {
    "publicBaseUrl": {
      "description": "Scheme and host, no path, no trailing slash, no wildcard.",
      "type": "string",
      "pattern": "^https?://[^/*\\s]+$"
    },
    "profile": {"type": "string", "enum": ["core", "full"]},
    "allowedHosts": {
      "type": "array",
      "items": {
        "description": "example.com or *.example.com; `*` and `*example.com` match nothing useful and are refused.",
        "type": "string",
        "pattern": "^(\\*\\.)?[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*$"
      }
    },
    "corsOrigins": {
      "type": "array",
      "items": {
        "description": "An origin: scheme and host, optional port, no path, no trailing slash. `*` is refused.",
        "type": "string",
        "pattern": "^https?://[^/*\\s]+$"
      }
    },
    "firstSuperuser": {
      "type": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "cognito"],
      "properties": {
        "provider": {"type": "string", "enum": ["local", "cognito"]},
        "cognito": {
          "type": "object",
          "additionalProperties": false,
          "required": ["userPoolId", "clientId", "domain"],
          "properties": {
            "userPoolId": {"type": "string"},
            "clientId": {"type": "string"},
            "domain": {
              "description": "Empty, or the Hosted UI's domain name: lower-case letters, digits, dots and hyphens with at least one dot, no scheme, path or port. The API refuses to start with anything else.",
              "type": "string",
              "maxLength": 253,
              "pattern": "^$|^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
            }
          }
        }
      }
    },
    "awsRegion": {
      "description": "Empty, or an AWS region such as us-west-2.",
      "type": "string",
      "pattern": "^$|^[a-z]{2}(-[a-z]+)+-[0-9]{1,2}$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {
          "description": "Empty, or a versioned `<profile>-X.Y.Z[-pre]`; floating tags are refused.",
          "type": "string",
          "pattern": "^$|^(core|full)-[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        },
        "pullPolicy": {"type": "string", "enum": ["IfNotPresent", "Always", "Never"]},
        "api": {"$ref": "#/definitions/imageRef"},
        "web": {"$ref": "#/definitions/imageRef"}
      }
    },
    "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "existingSecret": {"type": "string"},
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretKey": {"type": "string"},
        "firstSuperuserPassword": {"type": "string"},
        "postgresUser": {"type": "string"},
        "postgresPassword": {"type": "string"},
        "auditHmacKey": {"type": "string"},
        "redisPassword": {"type": "string"},
        "metricsToken": {"type": "string"}
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object"}
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forwardedAllowIps"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1},
        "forwardedAllowIps": {"type": "string", "minLength": 1},
        "resources": {"type": "object"},
        "extraEnv": {"type": "array", "items": {"type": "object"}},
        "extraEnvFrom": {"type": "array", "items": {"type": "object"}},
        "podAnnotations": {"type": "object"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"}
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1},
        "resources": {"type": "object"},
        "podAnnotations": {"type": "object"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"type": "object"},
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"secretName": {"type": "string"}}
        }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundled": {"type": "boolean"},
        "image": {"type": "string", "minLength": 1},
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "database": {"type": "string", "minLength": 1},
        "schema": {"type": "string", "minLength": 1},
        "sslMode": {"type": "string", "enum": ["", "disable", "prefer", "require"]},
        "persistence": {"$ref": "#/definitions/persistence"},
        "resources": {"type": "object"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"}
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "bundled": {"type": "boolean"},
        "image": {"type": "string", "minLength": 1},
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "ssl": {"type": "boolean"},
        "persistence": {"$ref": "#/definitions/persistence"},
        "resources": {"type": "object"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"}
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"enabled": {"type": "boolean"}}
    }
  },
  "allOf": [
    {
      "description": "An explicit image tag's profile prefix must equal `profile`: a core image under profile=full ignores AUDIT_HMAC_KEY and serves no modules.",
      "if": {"properties": {"profile": {"const": "core"}}},
      "then": {"properties": {"image": {"properties": {"tag": {"pattern": "^$|^core-"}}}}},
      "else": {"properties": {"image": {"properties": {"tag": {"pattern": "^$|^full-"}}}}}
    },
    {
      "description": "Kubernetes refuses an Ingress host that is an IP address or carries a port. With the Ingress enabled, publicBaseUrl must be a DNS name without a port; otherwise set ingress.enabled=false and route to the Services yourself.",
      "if": {"properties": {"ingress": {"properties": {"enabled": {"const": true}}}}},
      "then": {
        "properties": {
          "publicBaseUrl": {
            "$comment": "No colon (port), no brackets (IPv6), and at least one letter (a DNS name; an IPv4 literal has none).",
            "pattern": "^https?://[^/:*\\s\\[\\]]*[A-Za-z][^/:*\\s\\[\\]]*$"
          }
        }
      }
    },
    {
      "description": "With auth.provider cognito the API needs the user pool, its app client and their region: without the pool or the client every sign-in is refused, and without the region the Cognito client calls us-east-1.",
      "if": {
        "properties": {"auth": {"properties": {"provider": {"const": "cognito"}}, "required": ["provider"]}},
        "required": ["auth"]
      },
      "then": {
        "properties": {
          "auth": {
            "properties": {
              "cognito": {
                "properties": {
                  "userPoolId": {"minLength": 1},
                  "clientId": {"minLength": 1}
                }
              }
            }
          },
          "awsRegion": {"minLength": 1}
        },
        "required": ["awsRegion"]
      }
    },
    {
      "description": "With existingSecret set, the chart creates no Secret, so an inline secret value would be silently ignored: refused instead.",
      "if": {"properties": {"existingSecret": {"minLength": 1}}, "required": ["existingSecret"]},
      "then": {
        "properties": {
          "secrets": {
            "additionalProperties": {"type": "string", "maxLength": 0}
          }
        }
      }
    }
  ],
  "definitions": {
    "imageRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {"type": "string", "minLength": 1},
        "storageClass": {"type": "string"}
      }
    }
  }
}
