# Repository-root build context (backend/Dockerfile, demo/*/Dockerfile).
# Keep the context small: everything below is never needed inside an image.
.git/
.github/
.claude/
.vscode/
.idea/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/htmlcov/
**/.coverage
**/coverage.xml
venv/
.venv/
**/*.egg-info/
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
**/tsconfig.tsbuildinfo
.env
.env.*
!.env.example
**/.env.local
**/*.log
**/.DS_Store
# docs/ is copied into the dashboard image (in-app documentation pages).
infrastructure/
backend/tests/
backend/lambda/
# Agent instructions are for working ON this repository, not for running it,
# so they must not travel in an image. Found by listing /app in a built image
# while removing the requirements files.
**/CLAUDE.md
**/Dockerfile
tests/
# The same three rules for the modules tree: the API image copies modules/ for
# the full profile, and none of these belong in it. modules/frontend/ is NOT
# here -- frontend/Dockerfile copies it into the dashboard image for the full
# profile, so it has to stay in the context; backend/Dockerfile leaves it out
# by copying modules/backend/ rather than modules/ whole.
modules/infrastructure/
modules/backend/tests/
modules/lambda/
sdk/*/node_modules/
sdk/*/dist/
sdk/android/
sdk/ios/
sdk/java/
sdk/dotnet/
sdk/elixir/
sdk/flutter/
sdk/go/
sdk/php/
sdk/ruby/
sdk/python/
demo/.pids/
demo/.logs/
demo/**/.api_key*
site/
