# Copy to .env.local (the seed script writes NEXT_PUBLIC_CONTROLVAR_API_KEY there for you).
# Each setting is still read under its name before the rename
# (NEXT_PUBLIC_EXPERIMENTLY_...) when the new name is not set.

# Controlvar backend (FastAPI). The SDK appends /api/v1 itself.
NEXT_PUBLIC_CONTROLVAR_API_URL=http://localhost:8000

# Plaintext API key for the `streampulse-app` key owned by admin@demo.com.
# Created by backend/scripts/seed_streampulse.py; also written to demo/streampulse/.api_key.
NEXT_PUBLIC_CONTROLVAR_API_KEY=

# Controlvar dashboard (Next.js frontend) — used for the links in the Controlvar panel.
NEXT_PUBLIC_CONTROLVAR_DASHBOARD_URL=http://localhost:3100
